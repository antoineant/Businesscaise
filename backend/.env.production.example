# Server Configuration
PORT=10000
NODE_ENV=production

# Database Configuration (Auto-populated from Render database)
# These will be automatically set by Render from the database service
# DB_HOST=<auto-populated>
# DB_PORT=<auto-populated>
# DB_NAME=<auto-populated>
# DB_USER=<auto-populated>
# DB_PASSWORD=<auto-populated>
# DATABASE_URL=<auto-populated>

# JWT Configuration
JWT_SECRET=<auto-generated-by-render>
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=/opt/render/project/src/uploads
MAX_FILE_SIZE=10485760

# CORS - UPDATE THESE WITH YOUR ACTUAL RENDER URLS
CORS_ORIGIN=https://businesscase-frontend.onrender.com,https://businesscase-gm-dashboard.onrender.com

# Perplexity AI (Optional - only if using AI features)
# PERPLEXITY_API_KEY=your_actual_api_key
PERPLEXITY_RATE_LIMIT=5
